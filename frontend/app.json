{
  "expo": {
    "name": "RoadMesh",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Fotografe danos e o estado das viaturas.",
        "NSPhotoLibraryUsageDescription": "Anexe fotografias aos registos das viaturas."
      },
      "bundleIdentifier": "com.emergent.meshworkshop.v4s3w1"
    },
    "android": {
      "permissions": ["CAMERA"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.emergent.meshworkshop.v4s3w1"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "expo-sharing",
      ["expo-image-picker", {
        "photosPermission": "Anexe fotografias aos registos das viaturas.",
        "cameraPermission": "Fotografe danos e o estado das viaturas.",
        "microphonePermission": false
      }]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
