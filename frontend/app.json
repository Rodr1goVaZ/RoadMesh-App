{
  "expo": {
    "name": "RoadMesh",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/roadmesh-logo.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Fotografe danos e o estado das viaturas.",
        "NSPhotoLibraryUsageDescription": "Anexe fotografias aos registos das viaturas.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.emergent.meshworkshop.v4s3w1"
    },
    "android": {
      "permissions": [
        "android.permission.CAMERA"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/roadmesh-logo.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.emergent.meshworkshop.v4s3w1"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/roadmesh-logo.png",
      "lang": "pt-PT",
      "themeColor": "#7A1E2B",
      "description": "RoadMesh · Gestão de oficinas"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/roadmesh-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Anexe fotografias aos registos das viaturas.",
          "cameraPermission": "Fotografe danos e o estado das viaturas.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b12cbaad-65c9-4da0-ba53-261c396696b2"
      }
    },
    "owner": "rodr1g0vazs-team"
  }
}
