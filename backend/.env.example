MONGO_URL=mongodb://127.0.0.1:27017/?replicaSet=rs0
DB_NAME=roadmesh
# Supabase/PostgreSQL: when set, replaces MongoDB for all application records.
# Keep this value ONLY on the backend. Use the pooler URI with SSL required.
# Apply backend/sql/001_initial.sql 002_backend_compatibility.sql and 003_business_modules.sql first.
DATABASE_URL=
DATABASE_POOL_SIZE=4
# Generate locally: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=
# Required only for managed photo storage
EMERGENT_LLM_KEY=
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Optional local photo storage (managed is the default)
# STORAGE_DRIVER=local
# LOCAL_MEDIA_ROOT=/absolute/private/media/folder

# Recuperação de acesso (HTTPS do frontend, sem query nem fragmento).
PASSWORD_RESET_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Armazenamento persistente privado para Vercel (opcional, substitui managed).
# STORAGE_DRIVER=supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=roadmesh-media
