MONGO_URL=mongodb://127.0.0.1:27017/?replicaSet=rs0
DB_NAME=roadmesh
# Supabase/PostgreSQL: when set, replaces MongoDB for all application records.
# Keep this value ONLY on the backend. Use the pooler URI with SSL required.
# Apply backend/sql/001_initial.sql and 002_backend_compatibility.sql first.
DATABASE_URL=
DATABASE_POOL_SIZE=4
# Generate locally: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=
# Required only for managed photo storage
EMERGENT_LLM_KEY=
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Optional local photo storage (managed is the default)
# STORAGE_DRIVER=local
# LOCAL_MEDIA_ROOT=/absolute/private/media/folder
